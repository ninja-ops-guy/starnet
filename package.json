{
  "name": "aerotech-staff",
  "displayName": "AeroTech Staff",
  "version": "0.13.1-fork.1",
  "description": "A local-first AI workstation forked from StarNet, reskinned with TechOps Hero industrial textures.",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "ninja-ops-guy",
    "url": "https://github.com/ninja-ops-guy"
  },
  "contributors": [
    {
      "name": "Andrew Sims",
      "url": "https://github.com/androoAGI"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ninja-ops-guy/AeroTech-Staff.git"
  },
  "homepage": "https://github.com/ninja-ops-guy/AeroTech-Staff#readme",
  "bugs": {
    "url": "https://github.com/ninja-ops-guy/AeroTech-Staff/issues"
  },
  "type": "module",
  "bin": {
    "aerotech": "sidecar/run.mjs",
    "aerotech-sidecar": "sidecar/run.mjs"
  },
  "scripts": {
    "dev": "node sidecar/run.mjs --dev",
    "start": "node sidecar/run.mjs",
    "build": "npm run build:sidecar && npm run build:frontend && npm run build:desktop",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:frontend": "vite build",
    "build:desktop": "tauri build",
    "lint": "eslint sidecar/ scripts/ shared/",
    "test": "node --test sidecar/**/*.test.mjs",
    "test:ui": "playwright test",
    "rebrand": "node scripts/rebrand.mjs",
    "asset-check": "node scripts/asset-check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "eslint": "^8.57.0",
    "playwright": "^1.42.0",
    "@tauri-apps/cli": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "aerotechManaged": {
    "minSidecar": "0.13.0",
    "updateChannel": "stable"
  },
  "keywords": [
    "ai-agent",
    "desktop-app",
    "local-first",
    "workstation",
    "starnet-fork",
    "techops-hero"
  ]
}
